# Copy to .env and fill in. .env is git-ignored -- never commit real values.
# In production, inject these from a secrets manager (AWS Secrets Manager, Vault, ...)
# instead of a file on disk.

ENVIRONMENT=production            # development | staging | production
LOG_LEVEL=INFO

# ---- Provider credentials (use BAA-covered, zero-data-retention accounts) ----
OPENAI_API_KEY=
PINECONE_API_KEY=

# ---- Application-level encryption (AES-256-GCM) ----
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MEDICAL_ENCRYPTION_KEY=
# Comma-separated old keys kept for decrypt-only during rotation (optional)
MEDICAL_ENCRYPTION_PREVIOUS_KEYS=

# ---- Models / retrieval ----
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
PINECONE_INDEX_NAME=medical-knowledge-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
RETRIEVAL_K=4
RETRIEVAL_MIN_SCORE=0.30
ALLOWED_CLEARANCE_GROUPS=cardiology

# ---- Redis (semantic cache + Celery broker) ----
REDIS_HOST=redis
REDIS_PORT=6379
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=
SEMANTIC_CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.02   # cosine distance; keep strict for clinical content
CACHE_TTL_SECONDS=86400
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND default to Redis DB 1 / 2 with REDIS_PASSWORD

# ---- Postgres (Phoenix storage) ----
DB_USER=phoenix
DB_PASSWORD=
DB_NAME=phoenix_db

# ---- Phoenix observability ----
PHOENIX_VERSION=version-11.0.0    # pin an exact arizephoenix/phoenix image tag
PHOENIX_SECRET=                   # >= 32 random chars; enables Phoenix auth
PHOENIX_ADMIN_INITIAL_PASSWORD=
PHOENIX_API_KEY=                  # create in the Phoenix UI after first boot (system key)
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
PHOENIX_PROJECT_NAME=medical-rag-enterprise
TRACING_ENABLED=true

# ---- Alerting ----
SLACK_WEBHOOK_URL=                # https://hooks.slack.com/services/...
